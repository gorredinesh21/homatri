# Copy to .env and fill in. Nothing here is required for local SQLite dev.

# ---- Database ----
# Local dev (default if unset): in-memory SQLite — no install needed.
#   DATABASE_URL=sqlite+aiosqlite:///:memory:
# Deploy machine (Postgres):
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/homatri
DATABASE_URL=sqlite+aiosqlite:///:memory:

# ---- LangSmith (observability) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=homatri-dev

# ---- GCP Vertex AI / Gemini ----
GCP_PROJECT=homatri-503308
GCP_LOCATION=global
GEMINI_MODEL=gemini-3.6-flash
