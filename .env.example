# ═══════════════════════════════════════════════════════════════
#  Homaatri — environment template.  Copy to `.env` and fill in.
#  (`.env` is git-ignored; never commit real secrets.)
# ═══════════════════════════════════════════════════════════════

# ── App ──
APP_ENV=development            # development | production
DEBUG=true
PUBLIC_BASE_URL=http://localhost:8000   # used for payment links & webhook callbacks

# ── Database ──
# Async DSN. docker-compose sets this automatically for the app container.
DATABASE_URL=postgresql+asyncpg://homatri:homatri@localhost:5432/homatri

# ── LLM (Hugging Face Inference Router, OpenAI-compatible) ──
HF_ROUTER_URL=https://router.huggingface.co/v1/chat/completions
# Provide the token as one value...
HF_TOKEN=
# ...or as two halves (they are concatenated). Legacy POC style.
HF_TOKEN_PART1=
HF_TOKEN_PART2=
LLM_PRIMARY_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_FALLBACK_MODEL=Qwen/Qwen3-8B
LLM_ENABLED=true              # false => always use deterministic offline parser

# ── WhatsApp provider ──
WHATSAPP_PROVIDER=mock        # mock | meta
WHATSAPP_VERIFY_TOKEN=HOMAATRI_VERIFY_TOKEN_2026
# Required only when WHATSAPP_PROVIDER=meta:
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v25.0

# ── Payments ──
PAYMENT_PROVIDER=demo         # demo | razorpay
# Required only when PAYMENT_PROVIDER=razorpay (test or live keys):
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Simulation knobs (demo realism) ──
SIMULATE_LATENCY=0.4          # seconds of fake processing delay in mock provider
WHATSAPP_TIMEOUT_LIMIT=3.0    # Meta webhook SLA target we must beat
