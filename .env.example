# ═══════════════════════════════════════════════════════════════
#  Homaatri — environment template.  Copy to `.env` and fill in.
#  (`.env` is git-ignored; never commit real secrets.)
# ═══════════════════════════════════════════════════════════════

# ── App ──
APP_ENV=development            # development | production
DEBUG=true
PUBLIC_BASE_URL=http://localhost:8000   # used for payment links & webhook callbacks

# ── Database ──
# Async DSN. docker-compose overrides this to point at the `db` service.
DATABASE_URL=postgresql+asyncpg://homatri:homatri@localhost:5432/homatri

# ── LLM / Amazon Bedrock ──
# LLM calls go through Bedrock via langchain-aws / boto3. Set LLM_ENABLED=false
# to always use the deterministic offline parser (no AWS calls at all).
LLM_ENABLED=true
# AWS region where your Bedrock model access is enabled.
AWS_REGION=us-east-1
# AWS credentials for boto3's default credential chain. Fill these in for the
# container (they are passed through as env vars, never baked into the image).
# Alternatively leave them blank and mount ~/.aws read-only (see docker-compose.yml).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bedrock model ids (must be enabled in your AWS account / region):
BEDROCK_MODEL_ID=us.meta.llama4-scout-17b-instruct-v1:0
BEDROCK_FALLBACK_MODEL_ID=qwen.qwen3-next-80b-a3b
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ── WhatsApp provider ──
WHATSAPP_PROVIDER=mock        # mock | meta
WHATSAPP_VERIFY_TOKEN=HOMAATRI_VERIFY_TOKEN_2026
# Required only when WHATSAPP_PROVIDER=meta:
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v25.0

# ── Payments ──
PAYMENT_PROVIDER=demo         # demo | razorpay
# Required only when PAYMENT_PROVIDER=razorpay (test or live keys):
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Simulation knobs (demo realism) ──
SIMULATE_LATENCY=0.4          # seconds of fake processing delay in mock provider
WHATSAPP_TIMEOUT_LIMIT=3.0    # Meta webhook SLA target we must beat
